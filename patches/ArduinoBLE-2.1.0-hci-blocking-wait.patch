diff -ruN a/src/utility/HCIVirtualTransport.cpp b/src/utility/HCIVirtualTransport.cpp
--- a/src/utility/HCIVirtualTransport.cpp	2026-08-25 12:18:12
+++ b/src/utility/HCIVirtualTransport.cpp	2026-08-25 12:18:12
@@ -34,6 +34,8 @@
 #define HCI_VHCI_IO_TIMEOUT_MS 1000
 #endif
 
+static volatile TaskHandle_t hci_wait_task = nullptr;
+
 // IDF 5.5 VHCI send uses the caller's stack for controller/coex work. Stock
 // ArduinoBLE's 2048-byte bleTask overflows; the next take is a 0xffffffff
 // semaphore and the internal heap is smashed.
@@ -58,6 +60,10 @@
   }
   // Bound the VHCI RX callback: drop if the host is not draining within 1 s.
   (void)xStreamBufferSend(rec_buffer, data, length, pdMS_TO_TICKS(HCI_VHCI_IO_TIMEOUT_MS));
+  TaskHandle_t waiter = hci_wait_task;
+  if (waiter != nullptr) {
+    xTaskNotifyGive(waiter);
+  }
   return 0;
 }
 
@@ -182,11 +188,23 @@
 
 void HCIVirtualTransportClass::wait(unsigned long timeout)
 {
-  for (unsigned long start = (esp_timer_get_time() / 1000ULL); ((esp_timer_get_time() / 1000ULL) - start) < timeout;) {
-    if (available()) {
-      break;
-    }
+  // Stock ArduinoBLE busy-spins on esp_timer. Block on VHCI RX so
+  // BLE.poll(timeout) yields until a packet or the deadline.
+  if (rec_buffer == nullptr || timeout == 0 || available()) {
+    return;
   }
+  (void)ulTaskNotifyTake(pdTRUE, 0);
+  hci_wait_task = xTaskGetCurrentTaskHandle();
+  if (available()) {
+    hci_wait_task = nullptr;
+    return;
+  }
+  TickType_t ticks = pdMS_TO_TICKS(timeout);
+  if (ticks < 1) {
+    ticks = 1;
+  }
+  (void)ulTaskNotifyTake(pdTRUE, ticks);
+  hci_wait_task = nullptr;
 }
 
 int HCIVirtualTransportClass::available()
