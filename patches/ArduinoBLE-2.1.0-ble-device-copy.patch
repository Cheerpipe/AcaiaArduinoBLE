+size_t BLEDevice::copyAddress(char* buffer, size_t capacity) const
+{
+  if (buffer == NULL || capacity == 0) {
+    return 0;
+  }
+
+  int n = snprintf(buffer, capacity, "%02x:%02x:%02x:%02x:%02x:%02x",
+                   _address[5], _address[4], _address[3], _address[2],
+                   _address[1], _address[0]);
+  if (n < 0) {
+    buffer[0] = '\0';
+    return 0;
+  }
+  if ((size_t)n >= capacity) {
+    return capacity - 1;
+  }
+  return (size_t)n;
+}
+
+size_t BLEDevice::copyLocalName(char* buffer, size_t capacity) const
+{
+  if (buffer == NULL || capacity == 0) {
+    return 0;
+  }
+  buffer[0] = '\0';
+
+  for (int i = 0; i < _eirDataLength;) {
+    int eirLength = _eirData[i++];
+    int eirType = _eirData[i++];
+
+    if (eirType == 0x08 || eirType == 0x09) {
+      int nameLen = eirLength - 1;
+      if (nameLen < 0) {
+        return 0;
+      }
+      size_t copyLen = (size_t)nameLen;
+      if (copyLen >= capacity) {
+        copyLen = capacity - 1;
+      }
+      memcpy(buffer, &_eirData[i], copyLen);
+      buffer[copyLen] = '\0';
+      return copyLen;
+    }
+
+    i += (eirLength - 1);
+  }
+
+  return 0;
+}
+
 bool BLEDevice::hasLocalName() const
 {
-  return (localName().length() > 0);
+  char name[32];
+  return copyLocalName(name, sizeof(name)) > 0;
 }
 
 bool BLEDevice::hasAdvertisedServiceUuid() const
