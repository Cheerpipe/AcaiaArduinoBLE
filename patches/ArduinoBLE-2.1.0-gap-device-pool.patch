@@ -29,6 +29,47 @@
 
 #define GAP_MAX_DISCOVERED_QUEUE_SIZE 32
 
+#ifndef GAP_DEVICE_POOL_ATTR
+#if defined(EXT_RAM_BSS_ATTR)
+#define GAP_DEVICE_POOL_ATTR EXT_RAM_BSS_ATTR
+#else
+#define GAP_DEVICE_POOL_ATTR
+#endif
+#endif
+
+struct GapDeviceSlot {
+  alignas(BLEDevice) uint8_t bytes[sizeof(BLEDevice)];
+};
+
+static GapDeviceSlot g_gapDevicePool[GAP_MAX_DISCOVERED_QUEUE_SIZE] GAP_DEVICE_POOL_ATTR;
+static uint32_t g_gapDeviceUsed = 0;
+
+static void* gapAllocDevice()
+{
+  for (unsigned int i = 0; i < GAP_MAX_DISCOVERED_QUEUE_SIZE; i++) {
+    uint32_t bit = (1u << i);
+    if ((g_gapDeviceUsed & bit) == 0) {
+      g_gapDeviceUsed |= bit;
+      return g_gapDevicePool[i].bytes;
+    }
+  }
+  return NULL;
+}
+
+static void gapFreeDevice(void* mem)
+{
+  if (mem == NULL) {
+    return;
+  }
+  for (unsigned int i = 0; i < GAP_MAX_DISCOVERED_QUEUE_SIZE; i++) {
+    if (mem == g_gapDevicePool[i].bytes) {
+      g_gapDeviceUsed &= ~(1u << i);
+      return;
+    }
+  }
+  BLEHostFree(mem);
+}
+
 #define GAP_ADV_IND (0x00)
