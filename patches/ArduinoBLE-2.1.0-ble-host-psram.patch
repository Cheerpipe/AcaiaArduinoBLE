diff -ruN a/src/utility/BLEHostAlloc.cpp b/src/utility/BLEHostAlloc.cpp
--- a/src/utility/BLEHostAlloc.cpp	1969-12-31 21:00:00
+++ b/src/utility/BLEHostAlloc.cpp	2026-08-20 00:11:12
@@ -0,0 +1,52 @@
+/*
+  BLE host allocator for Shot Stopper / ESP32 ArduinoBLE VHCI builds.
+*/
+
+#include "BLEHostAlloc.h"
+
+static uint32_t g_bleHostAllocPsram = 0;
+static uint32_t g_bleHostAllocFallback = 0;
+
+extern "C" uint32_t BLEHostAllocPsramCount(void) {
+  return g_bleHostAllocPsram;
+}
+
+extern "C" uint32_t BLEHostAllocFallbackCount(void) {
+  return g_bleHostAllocFallback;
+}
+
+extern "C" void* BLEHostAlloc(size_t size) {
+  if (size == 0) {
+    return NULL;
+  }
+
+#if defined(ESP32)
+  void* block = heap_caps_malloc(size, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+  if (block != NULL) {
+    g_bleHostAllocPsram++;
+    return block;
+  }
+  block = heap_caps_malloc(size, MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
+  if (block != NULL) {
+    g_bleHostAllocFallback++;
+  }
+  return block;
+#else
+  void* block = malloc(size);
+  if (block != NULL) {
+    g_bleHostAllocFallback++;
+  }
+  return block;
+#endif
+}
+
+extern "C" void BLEHostFree(void* ptr) {
+  if (ptr == NULL) {
+    return;
+  }
+#if defined(ESP32)
+  heap_caps_free(ptr);
+#else
+  free(ptr);
+#endif
+}
diff -ruN a/src/utility/BLEHostAlloc.h b/src/utility/BLEHostAlloc.h
--- a/src/utility/BLEHostAlloc.h	1969-12-31 21:00:00
+++ b/src/utility/BLEHostAlloc.h	2026-08-20 00:11:12
@@ -0,0 +1,35 @@
+/*
+  BLE host allocator for Shot Stopper / ESP32 ArduinoBLE VHCI builds.
+
+  Small GAP/ATT/GATT host objects normally go through malloc() and stay in
+  internal DRAM because CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL (or the Arduino
+  equivalent) keeps blocks under ~4 KiB out of PSRAM. Prefer SPIRAM here so
+  discovery queues and remote ATT trees do not compete with the controller.
+*/
+
+#ifndef _BLE_HOST_ALLOC_H_
+#define _BLE_HOST_ALLOC_H_
+
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+#if defined(ESP32)
+#include <esp_heap_caps.h>
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+uint32_t BLEHostAllocPsramCount(void);
+uint32_t BLEHostAllocFallbackCount(void);
+
+void* BLEHostAlloc(size_t size);
+void BLEHostFree(void* ptr);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
