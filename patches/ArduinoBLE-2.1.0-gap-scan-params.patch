 void GAPClass::setAdvertisingInterval(uint16_t advertisingInterval)
 {
   _advertisingInterval = advertisingInterval;
+}
+
+void GAPClass::setScanParameters(uint16_t interval, uint16_t window)
+{
+  if (interval < 0x0012 || interval > 0x1000 || (interval & 1U) != 0) {
+    return;
+  }
+  if (window < 0x0011 || window > 0x1000 || window > interval) {
+    return;
+  }
+  _scanInterval = interval;
+  _scanWindow = window;
 }
 
