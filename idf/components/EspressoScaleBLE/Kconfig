choice ESPRESSO_SCALE_BLE_BACKEND
    prompt "Espresso scale BLE backend"
    default ESPRESSO_SCALE_BLE_BACKEND_ARDUINOBLE
    help
        Select exactly one BLE host for the scale client. ArduinoBLE remains
        the rollback default until the phase-5 physical soak and beta gate are
        approved. NimBLE is the release candidate.

    config ESPRESSO_SCALE_BLE_BACKEND_ARDUINOBLE
        bool "ArduinoBLE (temporary rollback)"

    config ESPRESSO_SCALE_BLE_BACKEND_NIMBLE
        bool "ESP-IDF NimBLE (release candidate)"
        depends on BT_NIMBLE_ENABLED

endchoice
