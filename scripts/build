#!/usr/bin/env bash
# Compile Shot Stopper into build/<architecture>.
# Legacy arduino-cli path — unsupported. Use ./scripts/build-idf for official builds.
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=scripts/shotstopper_board.sh
source "$SCRIPT_DIR/shotstopper_board.sh"
# shellcheck source=scripts/shotstopper_cli.sh
source "$SCRIPT_DIR/shotstopper_cli.sh"

# ESP32 Arduino 3.3.x / IDF 5.5 emits hundreds of -Wmissing-field-initializers
# diagnostics from TinyUSB and SPI flash HAL designated initializers. extra_flags
# is applied before -Wextra, so the suppression must live on warning_flags.all.
readonly WARNING_FLAGS_ALL="-Wall -Wextra -Wno-missing-field-initializers"

usage() {
  cat <<EOF
Usage: ./scripts/build [flags]

Compile Shot Stopper (legacy arduino-cli, unsupported) and write artifacts to
build/<architecture>. Prefer ./scripts/build-idf.

Required parameters: --arch. --flags is optional and prompted once.

$(ss_flag_help)

$(shotstopper_arch_help)

Recommended development compile flags (Enter at the prompt):
  $SS_CLI_DEFAULT_FLAGS

Examples:
  ./scripts/build --arch n16r8
  ./scripts/build -a n8r4 -f "-DSHOT_STOPPER_ENABLE_BUZZER=2"
EOF
}

ss_cli_parse "$@" || exit $?
if [[ "$SS_CLI_HELP_REQUESTED" == "1" ]]; then
  usage
  exit 0
fi

ss_cli_resolve "arch" "flags" || exit $?
shotstopper_resolve_board "$(ss_get arch)"

command -v arduino-cli >/dev/null 2>&1 || {
  echo "arduino-cli not found on PATH." >&2
  exit 127
}
command -v node >/dev/null 2>&1 || {
  echo "node not found on PATH (needed for the Web UI and OTA marker)." >&2
  exit 127
}

root="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
cd "$root"

# GAP scan stock 20/20, OOM-safe discover, BLE host objects in PSRAM (ArduinoBLE 2.1.0).
./scripts/patch_arduinoble.sh

echo "Building $SHOTSTOPPER_ARCH"
./scripts/gen_version.sh "$SHOTSTOPPER_ARCH"
node ./scripts/gen_web_ui.js
rm -rf "$SHOTSTOPPER_BUILD_DIR"
mkdir -p "$SHOTSTOPPER_BUILD_DIR"

arduino-cli compile \
  --fqbn "$SHOTSTOPPER_FQBN" \
  --warnings all \
  --build-property "compiler.warning_flags.all=$WARNING_FLAGS_ALL" \
  --build-property "compiler.cpp.extra_flags=$(ss_get flags)" \
  --library libraries/EspressoScaleBLE \
  --build-path "$SHOTSTOPPER_BUILD_DIR" \
  shotStopper

# The controller refuses any OTA image without this marker, so a build that
# somehow dropped it must fail here and not on the machine.
image="$SHOTSTOPPER_BUILD_DIR/shotStopper.ino.bin"
if [[ ! -f "$image" ]]; then
  echo "Build did not produce $image, so the OTA marker could not be verified." >&2
  echo "Do not upload an unverified image over Wi-Fi." >&2
  exit 1
fi
echo "Image OTA identity:"
node ./scripts/image_tag.js "$image" --expect-arch "$SHOTSTOPPER_ARCH"

ss_cli_save
