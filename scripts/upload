#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=scripts/shotstopper_board.sh
source "$SCRIPT_DIR/shotstopper_board.sh"

readonly DEFAULT_ARCH="$SHOTSTOPPER_DEFAULT_ARCH"

usage() {
  cat <<EOF
Uso: ./scripts/upload [ruta_serial] [arquitectura]

Sube automáticamente el binario ya compilado desde build/<arquitectura>.

Sin argumentos se usan todos los valores por defecto. Si se indica una ruta
serial, la arquitectura también es obligatoria.

Valores por defecto (sin argumentos):
  ruta_serial:  $SHOTSTOPPER_DEFAULT_PORT_HELP
  arquitectura: $DEFAULT_ARCH

$(shotstopper_arch_help)

Ejemplos:
  ./scripts/upload
  ./scripts/upload /dev/cu.usbmodem2101 n16r8
  ./scripts/upload /dev/cu.usbmodem2101 n8r4
EOF
}

if [[ "${1:-}" == "help" || "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  if [[ $# -ne 1 ]]; then
    usage >&2
    exit 2
  fi
  usage
  exit 0
fi

if [[ $# -gt 2 ]]; then
  usage >&2
  exit 2
fi

if [[ $# -eq 0 ]]; then
  shotstopper_resolve_port required || exit 1
  port="$SHOTSTOPPER_PORT"
  arch="$DEFAULT_ARCH"
elif [[ $# -eq 1 ]]; then
  echo "Falta la arquitectura después de la ruta serial." >&2
  usage >&2
  exit 2
else
  port="$1"
  arch="$2"
fi

shotstopper_resolve_board "$arch"

command -v arduino-cli >/dev/null 2>&1 || {
  echo "No se encontró arduino-cli en PATH." >&2
  exit 127
}

root="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
cd "$root"

if [[ ! -f "$SHOTSTOPPER_BUILD_DIR/shotStopper.ino.bin" ]]; then
  echo "No existe $SHOTSTOPPER_BUILD_DIR/shotStopper.ino.bin. Ejecuta ./scripts/build primero." >&2
  exit 1
fi

echo "Subiendo $SHOTSTOPPER_ARCH por $port"

arduino-cli upload \
  --fqbn "$SHOTSTOPPER_FQBN" \
  --port "$port" \
  --input-dir "$SHOTSTOPPER_BUILD_DIR" \
  shotStopper
