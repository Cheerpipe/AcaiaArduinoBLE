#!/usr/bin/env bash
# Run Cppcheck against an existing Arduino CLI compilation database.
# This script deliberately never builds the firmware.
set -uo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=scripts/shotstopper_board.sh
source "$SCRIPT_DIR/shotstopper_board.sh"
# shellcheck source=scripts/shotstopper_cli.sh
source "$SCRIPT_DIR/shotstopper_cli.sh"

readonly ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
readonly SUPPRESSIONS_FILE="$ROOT/scripts/cppcheck-suppressions.txt"

usage() {
  cat <<EOF
Usage: ./scripts/static [flags]

Run Cppcheck against a compilation database already produced by Arduino CLI.
The output directory is deleted and recreated on every run. This script never
builds the firmware; run ./scripts/build separately first.

Required parameters: --arch (implies build/<architecture>).
--build-dir and --output-dir are one-shot overrides: they are not persisted.

$(ss_flag_help)

Examples:
  ./scripts/static --arch n16r8
  ./scripts/static -a n8r4 -o reports/analysis-n8r4
EOF
}

ss_cli_parse "$@" || exit $?
if [[ "$SS_CLI_HELP_REQUESTED" == "1" ]]; then
  usage
  exit 0
fi

ss_cli_resolve "arch" || exit $?
shotstopper_resolve_board "$(ss_get arch)" || exit 2

if ss_is_set build_dir; then
  build_dir="$(ss_get build_dir)"
else
  build_dir="$SHOTSTOPPER_BUILD_DIR"
fi
if ss_is_set output_dir; then
  output_dir="$(ss_get output_dir)"
else
  output_dir="reports/static-analysis"
fi

case "$build_dir" in
  /*) build_path="$build_dir" ;;
  *) build_path="$ROOT/$build_dir" ;;
esac

# Keep the destructive cleanup strictly inside the repository.
case "$output_dir" in
  /*|*'..'*)
    echo "Output directory must be a relative path inside the repository." >&2
    exit 2
    ;;
esac
output_path="$ROOT/$output_dir"
compile_commands="$build_path/compile_commands.json"

for tool in cppcheck; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "$tool not found on PATH." >&2
    exit 127
  }
done

if [[ ! -f "$compile_commands" ]]; then
  echo "$compile_commands does not exist." >&2
  echo "Build the chosen variant first (e.g. ./scripts/build --arch $SHOTSTOPPER_ARCH)." >&2
  exit 1
fi

if [[ ! -f "$SUPPRESSIONS_FILE" ]]; then
  echo "Suppressions file $SUPPRESSIONS_FILE does not exist." >&2
  exit 1
fi

rm -rf "$output_path"
mkdir -p "$output_path"

printf 'Build database: %s\n' "$compile_commands" > "$output_path/README.txt"
printf 'Generated: %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" >> "$output_path/README.txt"

echo "Running Cppcheck on $build_dir..."
cppcheck \
  --project="$compile_commands" \
  --suppressions-list="$SUPPRESSIONS_FILE" \
  --file-filter='build/*/sketch/*.cpp' \
  --file-filter='libraries/EspressoScaleBLE/src/*.cpp' \
  --file-filter='libraries/EspressoScaleBLE/src/protocols/*.cpp' \
  --file-filter='shotStopper/*.cpp' \
  --enable=warning,performance,portability \
  --inconclusive \
  --error-exitcode=1 \
  2>&1 | tee "$output_path/cppcheck.txt"
cppcheck_status=${PIPESTATUS[0]}

printf '\nCppcheck exit status: %d\n' "$cppcheck_status" | tee -a "$output_path/README.txt"

echo "Reports saved under $output_dir/"
if [[ $cppcheck_status -ne 0 ]]; then
  echo "Analysis finished with diagnostics or an error; check the reports." >&2
  exit 1
fi

ss_cli_save
