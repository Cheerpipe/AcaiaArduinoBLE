#!/usr/bin/env bash
# Update controller firmware over Wi-Fi, without a USB cable.
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=scripts/shotstopper_board.sh
source "$SCRIPT_DIR/shotstopper_board.sh"
# shellcheck source=scripts/shotstopper_cli.sh
source "$SCRIPT_DIR/shotstopper_cli.sh"

usage() {
  cat <<EOF
Usage: ./scripts/ota [flags]

Upload the already-built image to the controller, verify it, and leave it
ready to boot.

Required parameters: --arch, --host, and --token.
The token is the MicraShotStopperAP SoftAP password. The controller rejects
updates while that password is still the factory default.

$(ss_flag_help)

$(shotstopper_arch_help)

Examples:
  ./scripts/ota --arch n16r8 --host 192.168.1.50
  ./scripts/ota -a n16r8 -H 192.168.4.1 -t "my-AP-password"

The image comes from build/<architecture>/shotStopper.ino.bin, so compile
first (./scripts/build / ./scripts/b) or use ./scripts/bo, which does both.
You can also use the short alias ./scripts/o.
EOF
}

ss_cli_parse "$@" || exit $?
if [[ "$SS_CLI_HELP_REQUESTED" == "1" ]]; then
  usage
  exit 0
fi

ss_cli_resolve "arch host token" || exit $?
shotstopper_resolve_board "$(ss_get arch)"

for tool in curl node; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "$tool not found on PATH." >&2
    exit 127
  }
done

root="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
cd "$root"

image="$SHOTSTOPPER_BUILD_DIR/shotStopper.ino.bin"
if [[ ! -f "$image" ]]; then
  echo "$image does not exist." >&2
  echo "Build first: ./scripts/build --arch $SHOTSTOPPER_ARCH" >&2
  exit 1
fi

host="$(ss_get host)"
base="http://$host"

# The controller rejects an image for another board, but checking here avoids
# uploading megabytes for nothing and catches a stale build/.
echo "Local image identity:"
node ./scripts/image_tag.js "$image" --expect-arch "$SHOTSTOPPER_ARCH"

# The token travels in a curl config file, not on the command line where any
# `ps` would expose it.
curl_config="$(mktemp "${TMPDIR:-/tmp}/shotstopper-ota.XXXXXX")"
chmod 600 "$curl_config"
cleanup() { rm -f "$curl_config" "${body_file:-}"; }
trap cleanup EXIT
# Inside curl config-file quotes, \ and " are escapes. A WPA2 password may
# contain both: without escaping them the token arrives truncated and the
# controller replies OTA_TOKEN_INVALID with no further clues.
ota_token="$(ss_get token)"
ota_token="${ota_token//\\/\\\\}"
ota_token="${ota_token//\"/\\\"}"
printf 'header = "X-OTA-Token: %s"\n' "$ota_token" > "$curl_config"
unset ota_token

body_file="$(mktemp "${TMPDIR:-/tmp}/shotstopper-ota-body.XXXXXX")"

# ota_request <method> <path> <body-file|""> <timeout>
# Leaves the response body in $body_file and the status in $OTA_HTTP_STATUS.
ota_request() {
  local method="$1" path="$2" payload="$3" timeout="$4"
  local args=(--show-error --config "$curl_config"
              --max-time "$timeout" --output "$body_file"
              --write-out '%{http_code}' --request "$method")
  if [[ -n "$payload" ]]; then
    # Progress bar replaces --silent: an image takes minutes and without
    # progress it looks hung.
    args+=(--progress-bar
           --header "Content-Type: application/octet-stream"
           --data-binary "@$payload")
  else
    args+=(--silent)
  fi
  OTA_HTTP_STATUS="$(curl "${args[@]}" "$base$path")" || return 1
  return 0
}

ota_field() {
  node -e '
const fs = require("fs");
let data = {};
try { data = JSON.parse(fs.readFileSync(process.argv[1], "utf8")); } catch (_) {}
const value = process.argv[2].split(".").reduce(
    (node, key) => (node == null ? undefined : node[key]), data);
process.stdout.write(value === undefined || value === null ? "" : String(value));
' "$body_file" "$1"
}

ota_fail() {
  local action="$1"
  local error message
  error="$(ota_field error)"
  message="$(ota_field message)"
  printf '%s failed (HTTP %s).\n' "$action" "${OTA_HTTP_STATUS:-no response}" >&2
  [[ -n "$error" ]] && printf 'Code: %s\n' "$error" >&2
  [[ -n "$message" ]] && printf '%s\n' "$message" >&2
  if [[ -z "$error" && -s "$body_file" ]]; then
    head -c 400 "$body_file" >&2
    printf '\n' >&2
  fi
  exit 1
}

echo
echo "Querying $base ..."
ota_request GET /api/v1/ota "" 20 || {
  echo "Could not reach the controller at $base." >&2
  echo "Check the IP (Admin or Diagnostic in the Web UI; SoftAP is 192.168.4.1)." >&2
  exit 1
}
[[ "$OTA_HTTP_STATUS" == "200" ]] || ota_fail "Status query"

if [[ "$(ota_field available)" != "true" ]]; then
  echo "This controller has no second application partition." >&2
  echo "Update it over USB instead." >&2
  exit 1
fi
printf 'Controller: %s · %s\n' "$(ota_field running.version)" "$(ota_field running.arch)"
if [[ "$(ota_field safe)" != "true" ]]; then
  printf 'Machine is busy (%s). Wait until Ready.\n' "$(ota_field lockReason)" >&2
  exit 1
fi

size="$(wc -c < "$image" | tr -d ' ')"
printf 'Uploading %s (%s KiB)...\n' "$image" "$((size / 1024))"
# Wide window: ESP32 flash write sets the pace, not the network.
ota_request POST /api/v1/ota "$image" 900 || {
  echo "Upload was cut short. Running firmware was not touched." >&2
  exit 1
}
[[ "$OTA_HTTP_STATUS" == "200" ]] || ota_fail "Image verification"

staged_version="$(ota_field staged.version)"
staged_arch="$(ota_field staged.arch)"
if [[ -z "$staged_version" ]]; then
  echo "Controller did not report a verified image." >&2
  exit 1
fi
printf '\nVerified image: %s · %s\n' "$staged_version" "$staged_arch"

if ss_can_prompt; then
  printf 'Commit and reboot the controller? [y/N]: ' > /dev/tty
  IFS= read -r answer < /dev/tty || answer=""
  case "$answer" in
    y|Y|yes|YES) ;;
    *)
      echo "Cancelled. Discarding the image on the controller."
      ota_request POST /api/v1/ota/abort "" 20 || true
      exit 1
      ;;
  esac
fi

echo "Committing..."
ota_request POST /api/v1/ota/flash "" 30 || {
  echo "Could not confirm the boot partition change." >&2
  exit 1
}
[[ "$OTA_HTTP_STATUS" == "202" ]] || ota_fail "Commit"

cat <<EOF

Done. The controller reboots once the machine is free.
The new version confirms itself by serving its Web UI; if it cannot, the
bootloader rolls back to the previous version.
EOF

ss_cli_save
