#!/usr/bin/env bash
# Flash an already compiled image over USB.
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=scripts/shotstopper_board.sh
source "$SCRIPT_DIR/shotstopper_board.sh"
# shellcheck source=scripts/shotstopper_cli.sh
source "$SCRIPT_DIR/shotstopper_cli.sh"

usage() {
  cat <<EOF
Usage: ./scripts/flash [flags]

Flash a firmware binary over USB. Without --image, uses the already-built
binary from build/<architecture>.
Does not recompile and does not open the monitor.

Required parameters: --port and --arch.

$(ss_flag_help)

$(shotstopper_arch_help)

Examples:
  ./scripts/flash --port /dev/cu.usbmodem2101 --arch n16r8
  ./scripts/flash -p /dev/cu.usbmodem2101 -a n8r4
  ./scripts/flash -p /dev/cu.usbmodem2101 -a n16r8 --image ~/Downloads/shotstopper.bin
EOF
}

ss_cli_parse "$@" || exit $?
if [[ "$SS_CLI_HELP_REQUESTED" == "1" ]]; then
  usage
  exit 0
fi

ss_cli_resolve "port arch" || exit $?
ss_cli_normalize_image || exit $?
shotstopper_resolve_board "$(ss_get arch)"

command -v arduino-cli >/dev/null 2>&1 || {
  echo "arduino-cli not found on PATH." >&2
  exit 127
}
command -v node >/dev/null 2>&1 || {
  echo "node not found on PATH (needed to verify the firmware image)." >&2
  exit 127
}

root="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
cd "$root"

image="${SHOTSTOPPER_BUILD_DIR}/shotStopper.ino.bin"
if ss_is_set image; then
  image="$(ss_get image)"
elif [[ ! -f "$image" ]]; then
  echo "$image does not exist. Run ./scripts/build first or pass --image <path>." >&2
  exit 1
fi

echo "Local image identity:"
node ./scripts/image_tag.js "$image" --expect-arch "$SHOTSTOPPER_ARCH"

port="$(ss_get port)"
echo "Flashing $image ($SHOTSTOPPER_ARCH) via $port"

if ss_is_set image; then
  arduino-cli upload \
    --fqbn "$SHOTSTOPPER_FQBN" \
    --port "$port" \
    --input-file "$image" \
    shotStopper
else
  arduino-cli upload \
    --fqbn "$SHOTSTOPPER_FQBN" \
    --port "$port" \
    --input-dir "$SHOTSTOPPER_BUILD_DIR" \
    shotStopper
fi

ss_cli_save
