#!/usr/bin/env bash
# Compile Shot Stopper with ESP-IDF (Arduino-ESP32 as a component) into
# build-idf/<arquitectura>. This does not replace ./scripts/build
# (arduino-cli production firmware).
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=scripts/shotstopper_board.sh
source "$SCRIPT_DIR/shotstopper_board.sh"
# shellcheck source=scripts/shotstopper_cli.sh
source "$SCRIPT_DIR/shotstopper_cli.sh"
# shellcheck source=scripts/shotstopper_idf.sh
source "$SCRIPT_DIR/shotstopper_idf.sh"

usage() {
  cat <<EOF
Uso: ./scripts/build-idf [flags]

Compila Shot Stopper con ESP-IDF (ALLOW_BSS en PSRAM) y deja los artefactos
en build-idf/<arquitectura>. No sustituye al firmware de producción de
./scripts/build.

Parámetros que necesita: --arch. --flags es opcional y se pregunta una vez.

$(ss_flag_help)

$(shotstopper_arch_help)

Flags de compilación recomendados para desarrollo (Enter en el prompt):
  $SS_CLI_DEFAULT_FLAGS

Requiere ESP-IDF 5.5.x. Si IDF_PATH no está definido, se usa
${IDF_DEFAULT_HOME} si existe.

Ejemplos:
  ./scripts/build-idf --arch n16r8
  ./scripts/build-idf -a n8r4 -f "-DSHOT_STOPPER_ENABLE_BUZZER=2"
EOF
}

ss_cli_parse "$@" || exit $?
if [[ "$SS_CLI_HELP_REQUESTED" == "1" ]]; then
  usage
  exit 0
fi

ss_cli_resolve "arch" "flags" || exit $?
shotstopper_resolve_board "$(ss_get arch)"
ss_idf_source
ss_idf_py_args

command -v node >/dev/null 2>&1 || {
  echo "No se encontró node en PATH (necesario para el Web UI y el marcador OTA)." >&2
  exit 127
}

root="$SS_CLI_ROOT"
cd "$root"

# GAP 40/20, OOM-safe discover, BLE host objects in PSRAM (ArduinoBLE 2.1.0).
ss_idf_ensure_arduino_ble "$IDF_PROJECT/third_party/ArduinoBLE"

echo "Compilando $SHOTSTOPPER_ARCH (IDF)"
./scripts/gen_version.sh "$SHOTSTOPPER_ARCH"
node ./scripts/gen_web_ui.js

export SHOT_STOPPER_EXTRA_FLAGS
SHOT_STOPPER_EXTRA_FLAGS="$(ss_get flags)"

mkdir -p "$IDF_BUILD_DIR"
# Spike sdkconfig / CMake cache predates Arduino autostart and the firmware
# project name. Reuse would keep ALLOW_BSS but skip AUTOSTART and g_probe checks.
if [[ -f "$IDF_BUILD_DIR/shotstopper_idf_spike.elf" ]] ||
   { [[ -f "$IDF_BUILD_DIR/CMakeCache.txt" ]] && grep -q 'shotstopper_idf_spike' "$IDF_BUILD_DIR/CMakeCache.txt"; } ||
   { [[ -f "$IDF_SDKCONFIG" ]] && ! grep -q '^CONFIG_AUTOSTART_ARDUINO=y$' "$IDF_SDKCONFIG"; }; then
  echo "Limpiando árbol de build del spike IDF"
  rm -rf "$IDF_BUILD_DIR"
  mkdir -p "$IDF_BUILD_DIR"
fi

echo "Compilando firmware IDF $SHOTSTOPPER_ARCH → $IDF_BUILD_DIR"

if [[ ! -f "$IDF_SDKCONFIG" ]] ||
   ! grep -q '^CONFIG_IDF_TARGET="esp32s3"$' "$IDF_SDKCONFIG"; then
  idf.py "${IDF_PY_ARGS[@]}" set-target esp32s3
fi

idf.py "${IDF_PY_ARGS[@]}" build

ss_idf_verify_firmware
ss_cli_save
