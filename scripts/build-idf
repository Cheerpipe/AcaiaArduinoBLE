#!/usr/bin/env bash
# Compile Shot Stopper with ESP-IDF (Arduino-ESP32 as a component) into
# build-idf/<architecture>. This is the official supported firmware build.
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=scripts/shotstopper_board.sh
source "$SCRIPT_DIR/shotstopper_board.sh"
# shellcheck source=scripts/shotstopper_cli.sh
source "$SCRIPT_DIR/shotstopper_cli.sh"
# shellcheck source=scripts/shotstopper_idf.sh
source "$SCRIPT_DIR/shotstopper_idf.sh"

usage() {
  cat <<EOF
Usage: ./scripts/build-idf [flags]

Compile Shot Stopper with ESP-IDF (official supported path) and write artifacts
to build-idf/<architecture>.

Required parameters: --arch. --flags is optional and prompted once.

$(ss_flag_help)

$(shotstopper_arch_help)

Recommended development compile flags (Enter at the prompt):
  $SS_CLI_DEFAULT_FLAGS

Requires ESP-IDF 5.5.x. If IDF_PATH is unset, ${IDF_DEFAULT_HOME} is used when
it exists.

Examples:
  ./scripts/build-idf --arch n16r8
  ./scripts/build-idf -a n16r8 -f "-DSHOT_STOPPER_ENABLE_JTAG=1"
EOF
}

ss_cli_parse "$@" || exit $?
if [[ "$SS_CLI_HELP_REQUESTED" == "1" ]]; then
  usage
  exit 0
fi

ss_cli_resolve "arch" "flags" || exit $?
shotstopper_resolve_board "$(ss_get arch)"
ss_idf_source
ss_idf_py_args

command -v node >/dev/null 2>&1 || {
  echo "node not found on PATH (needed for the Web UI and OTA marker)." >&2
  exit 127
}

root="$SS_CLI_ROOT"
cd "$root"

# GAP scan stock 20/20, OOM-safe discover, BLE host objects in PSRAM (ArduinoBLE 2.1.0).
ss_idf_ensure_arduino_ble "$IDF_PROJECT/third_party/ArduinoBLE"

echo "Building $SHOTSTOPPER_ARCH (IDF)"
./scripts/gen_version.sh "$SHOTSTOPPER_ARCH"
node ./scripts/gen_web_ui.js

export SHOT_STOPPER_EXTRA_FLAGS
SHOT_STOPPER_EXTRA_FLAGS="$(ss_get flags)"
echo "Extra compile flags: ${SHOT_STOPPER_EXTRA_FLAGS:-(none)}"

mkdir -p "$IDF_BUILD_DIR"
# Spike sdkconfig / CMake cache predates Arduino autostart and the firmware
# project name. Reuse would keep ALLOW_BSS but skip AUTOSTART and g_probe checks.
# Also rebuild when Shot Stopper Kconfig keys are missing from an older tree,
# when IPv6 was disabled (breaks arduino-esp32 → esp-modbus), or when the log
# ceiling predates runtime-selectable INFO/DEBUG application logging.
if [[ -f "$IDF_BUILD_DIR/shotstopper_idf_spike.elf" ]] ||
   { [[ -f "$IDF_BUILD_DIR/CMakeCache.txt" ]] && grep -q 'shotstopper_idf_spike' "$IDF_BUILD_DIR/CMakeCache.txt"; } ||
   { [[ -f "$IDF_SDKCONFIG" ]] && ! grep -q '^CONFIG_AUTOSTART_ARDUINO=y$' "$IDF_SDKCONFIG"; } ||
   { [[ -f "$IDF_SDKCONFIG" ]] && ! grep -q '^CONFIG_SHOT_STOPPER_ENABLE_BUZZER=' "$IDF_SDKCONFIG"; } ||
   { [[ -f "$IDF_SDKCONFIG" ]] && ! grep -q '^CONFIG_LWIP_IPV6=y$' "$IDF_SDKCONFIG"; } ||
   { [[ -f "$IDF_SDKCONFIG" ]] && ! grep -q '^CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y$' "$IDF_SDKCONFIG"; }; then
  echo "Cleaning stale IDF build tree"
  rm -rf "$IDF_BUILD_DIR"
  mkdir -p "$IDF_BUILD_DIR"
fi

echo "Building IDF firmware $SHOTSTOPPER_ARCH → $IDF_BUILD_DIR"
ss_idf_py_args
ss_idf_sync_extra_flags
ss_idf_sync_jtag_console

if [[ ! -f "$IDF_SDKCONFIG" ]] ||
   ! grep -q '^CONFIG_IDF_TARGET="esp32s3"$' "$IDF_SDKCONFIG"; then
  ss_idf_prepare_set_target
  idf.py "${IDF_PY_ARGS[@]}" set-target esp32s3
fi

ss_idf_commit_extra_flags_stamp

idf.py "${IDF_PY_ARGS[@]}" build

ss_idf_verify_firmware
ss_cli_save
