#!/usr/bin/env bash
# Flash an already compiled ESP-IDF image over USB.
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=scripts/shotstopper_board.sh
source "$SCRIPT_DIR/shotstopper_board.sh"
# shellcheck source=scripts/shotstopper_cli.sh
source "$SCRIPT_DIR/shotstopper_cli.sh"
# shellcheck source=scripts/shotstopper_idf.sh
source "$SCRIPT_DIR/shotstopper_idf.sh"

usage() {
  cat <<EOF
Usage: ./scripts/flash-idf [flags]

Flash an ESP-IDF firmware binary over USB. Without --image, uses the
already-built binary from build-idf/<architecture>. If the build tree is
missing or stale, idf.py rebuilds it first; with --no-check the existing
build outputs are flashed as-is. Does not open the monitor. This is the
official USB flash path (replaces the firmware currently on the device).

Required parameters: --port and --arch.

$(ss_flag_help)

$(shotstopper_arch_help)

Examples:
  ./scripts/flash-idf --port /dev/cu.usbmodem2101 --arch n16r8
  ./scripts/flash-idf -p /dev/cu.usbmodem2101 -a n8r4
  ./scripts/flash-idf -p /dev/cu.usbmodem2101 -a n16r8 --image ~/Downloads/shotstopper.bin
EOF
}

ss_cli_parse "$@" || exit $?
if [[ "$SS_CLI_HELP_REQUESTED" == "1" ]]; then
  usage
  exit 0
fi

ss_cli_resolve "port arch" || exit $?
ss_cli_normalize_image || exit $?
shotstopper_resolve_board "$(ss_get arch)"
ss_idf_source
ss_idf_py_args

cd "$SS_CLI_ROOT"

image="$IDF_IMAGE"
if ss_is_set image; then
  image="$(ss_get image)"
else
  ss_idf_require_image
fi

if [[ "$SS_CLI_NO_CHECK" == "1" ]]; then
  echo "Skipping local image verification (--no-check)."
else
  command -v node >/dev/null 2>&1 || {
    echo "node not found on PATH (needed to verify the firmware image)." >&2
    exit 127
  }
  echo "Local image identity:"
  node ./scripts/image_tag.js "$image" --expect-arch "$SHOTSTOPPER_ARCH"
fi

port="$(ss_get port)"
echo "Flashing $image ($SHOTSTOPPER_ARCH) via $port (IDF)"

if ss_is_set image; then
  command -v esptool.py >/dev/null 2>&1 || {
    echo "esptool.py not found on PATH (did ESP-IDF export.sh run?)." >&2
    exit 127
  }
  # An external application image replaces app0 only. Bootloader and partition
  # table remain in place, so the selected image must match this architecture.
  esptool.py --chip esp32s3 --port "$port" write_flash 0x10000 "$image"
elif [[ "$SS_CLI_NO_CHECK" == "1" ]]; then
  # The build tree was just produced (or the caller trusts it): flash the
  # project outputs directly. `idf.py flash` would re-run the build target,
  # duplicating the build step of ./scripts/bf-idf.
  if [[ ! -f "$IDF_BUILD_DIR/flash_args" ]]; then
    echo "$IDF_BUILD_DIR/flash_args does not exist." >&2
    echo "Build first: ./scripts/build-idf --arch $SHOTSTOPPER_ARCH" >&2
    exit 1
  fi
  command -v esptool.py >/dev/null 2>&1 || {
    echo "esptool.py not found on PATH (did ESP-IDF export.sh run?)." >&2
    exit 127
  }
  # flash_args lists bootloader, partition table, otadata and app at their
  # offsets with relative paths, so esptool must run from the build directory.
  (
    cd "$IDF_BUILD_DIR" &&
      esptool.py --chip esp32s3 --port "$port" write_flash @flash_args
  )
else
  idf.py "${IDF_PY_ARGS[@]}" -p "$port" flash
fi

ss_cli_save
