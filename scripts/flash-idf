#!/usr/bin/env bash
# Flash an already compiled ESP-IDF image over USB.
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=scripts/shotstopper_board.sh
source "$SCRIPT_DIR/shotstopper_board.sh"
# shellcheck source=scripts/shotstopper_cli.sh
source "$SCRIPT_DIR/shotstopper_cli.sh"
# shellcheck source=scripts/shotstopper_idf.sh
source "$SCRIPT_DIR/shotstopper_idf.sh"

usage() {
  cat <<EOF
Usage: ./scripts/flash-idf [flags]

Flash the already-built ESP-IDF binary from build-idf/<architecture> over USB.
Does not recompile and does not open the monitor. This is the official USB
flash path (replaces the firmware currently on the device).

Required parameters: --port and --arch.

$(ss_flag_help)

$(shotstopper_arch_help)

Examples:
  ./scripts/flash-idf --port /dev/cu.usbmodem2101 --arch n16r8
  ./scripts/flash-idf -p /dev/cu.usbmodem2101 -a n8r4
EOF
}

ss_cli_parse "$@" || exit $?
if [[ "$SS_CLI_HELP_REQUESTED" == "1" ]]; then
  usage
  exit 0
fi

ss_cli_resolve "port arch" || exit $?
shotstopper_resolve_board "$(ss_get arch)"
ss_idf_source
ss_idf_py_args
ss_idf_require_image

cd "$SS_CLI_ROOT"

port="$(ss_get port)"
echo "Flashing $SHOTSTOPPER_ARCH via $port (IDF)"

idf.py "${IDF_PY_ARGS[@]}" -p "$port" flash

ss_cli_save
