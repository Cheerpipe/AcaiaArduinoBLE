#!/usr/bin/env bash
# Build, upload, and monitor Shot Stopper (ESP-IDF) in one command.
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=scripts/shotstopper_board.sh
source "$SCRIPT_DIR/shotstopper_board.sh"
# shellcheck source=scripts/shotstopper_cli.sh
source "$SCRIPT_DIR/shotstopper_cli.sh"

usage() {
  cat <<EOF
Uso: ./scripts/bum-idf [flags]

Ejecuta, en orden: build-idf, upload-idf y monitor-idf.

Parámetros que necesita: --port, --arch y --speed. --flags es opcional.

$(ss_flag_help)

Ejemplos:
  ./scripts/bum-idf --port /dev/cu.usbmodem2101 --arch n16r8 --speed 115200
  ./scripts/bum-idf -p /dev/cu.usbmodem2101 -a n8r4 -s 115200
EOF
}

ss_cli_parse "$@" || exit $?
if [[ "$SS_CLI_HELP_REQUESTED" == "1" ]]; then
  usage
  exit 0
fi

ss_cli_resolve "port arch speed" "flags" || exit $?

root="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
cd "$root"

ss_cli_flags_for arch flags
./scripts/build-idf ${SS_CLI_FORWARD[@]+"${SS_CLI_FORWARD[@]}"}

ss_cli_flags_for port arch
./scripts/upload-idf ${SS_CLI_FORWARD[@]+"${SS_CLI_FORWARD[@]}"}

ss_cli_flags_for port speed
exec ./scripts/monitor-idf ${SS_CLI_FORWARD[@]+"${SS_CLI_FORWARD[@]}"}
