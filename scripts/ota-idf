#!/usr/bin/env bash
# Update ESP-IDF controller firmware over Wi-Fi, without a USB cable.
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=scripts/shotstopper_board.sh
source "$SCRIPT_DIR/shotstopper_board.sh"
# shellcheck source=scripts/shotstopper_cli.sh
source "$SCRIPT_DIR/shotstopper_cli.sh"
# shellcheck source=scripts/shotstopper_idf.sh
source "$SCRIPT_DIR/shotstopper_idf.sh"
# shellcheck source=scripts/shotstopper_ota.sh
source "$SCRIPT_DIR/shotstopper_ota.sh"

usage() {
  cat <<EOF
Usage: ./scripts/ota-idf [flags]

Upload the already-built ESP-IDF image to the controller, verify it, and leave
it ready to boot.

Required parameters: --arch, --host, and --password.
Pass the device password (including the factory default if unchanged).

$(ss_flag_help)

$(shotstopper_arch_help)

Examples:
  ./scripts/ota-idf --arch n16r8 --host 192.168.1.50
  ./scripts/ota-idf -a n16r8 -H 192.168.4.1 -t "my-device-password"
  ./scripts/ota-idf -a n16r8 -H 192.168.1.50 -t "my-device-password" --image ~/Downloads/shotstopper.bin
  ./scripts/ota-idf -a n16r8 -H 192.168.1.50 -t "my-device-password" --force

Without --image, the image comes from build-idf/<architecture>/shotstopper.bin,
so compile first (./scripts/build-idf / ./scripts/b-idf) or use
./scripts/bo-idf, which does both. You can also use the short alias
./scripts/o-idf.

With --force, the script commits without asking and waits until the rebooted
firmware confirms itself through its HTTP API; no Web UI reload is needed.
EOF
}

ss_cli_parse "$@" || exit $?
if [[ "$SS_CLI_HELP_REQUESTED" == "1" ]]; then
  usage
  exit 0
fi

ss_cli_resolve "arch host password" || exit $?
ss_cli_normalize_image || exit $?
shotstopper_resolve_board "$(ss_get arch)"
ss_idf_resolve_paths

root="$SS_CLI_ROOT"
cd "$root"

image="$IDF_IMAGE"
if ss_is_set image; then
  image="$(ss_get image)"
else
  ss_idf_require_image
fi

trap ss_ota_cleanup EXIT
ss_ota_run "$image" "$SHOTSTOPPER_ARCH" "$(ss_get host)" \
  "$(ss_get password)" "$SS_CLI_FORCE" || exit $?
ss_cli_save
