#!/usr/bin/env bash
# Actualiza el firmware ESP-IDF del controlador por Wi-Fi, sin cable USB.
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=scripts/shotstopper_board.sh
source "$SCRIPT_DIR/shotstopper_board.sh"
# shellcheck source=scripts/shotstopper_cli.sh
source "$SCRIPT_DIR/shotstopper_cli.sh"
# shellcheck source=scripts/shotstopper_idf.sh
source "$SCRIPT_DIR/shotstopper_idf.sh"

usage() {
  cat <<EOF
Uso: ./scripts/ota-idf [flags]

Sube la imagen ESP-IDF ya compilada al controlador, la verifica y la deja
arrancando.

Parámetros que necesita: --arch, --host y --token.
El token es la contraseña del punto de acceso MicraShotStopperAP. El
controlador rechaza la actualización mientras esa contraseña siga siendo la de
fábrica.

$(ss_flag_help)

$(shotstopper_arch_help)

Ejemplos:
  ./scripts/ota-idf --arch n16r8 --host 192.168.1.50
  ./scripts/ota-idf -a n16r8 -H 192.168.4.1 -t "mi-clave-del-AP"

La imagen sale de build-idf/<arquitectura>/shotstopper.bin, así que primero hay
que compilar (./scripts/build-idf / ./scripts/b-idf) o usar ./scripts/bo-idf,
que hace las dos cosas. También puedes usar el alias corto ./scripts/o-idf.
EOF
}

ss_cli_parse "$@" || exit $?
if [[ "$SS_CLI_HELP_REQUESTED" == "1" ]]; then
  usage
  exit 0
fi

ss_cli_resolve "arch host token" || exit $?
shotstopper_resolve_board "$(ss_get arch)"
ss_idf_resolve_paths

for tool in curl node; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "No se encontró $tool en PATH." >&2
    exit 127
  }
done

root="$SS_CLI_ROOT"
cd "$root"

ss_idf_require_image
image="$IDF_IMAGE"

host="$(ss_get host)"
base="http://$host"

# El controlador rechaza una imagen de otra placa, pero comprobarlo aquí evita
# subir megabytes para nada y detecta un build-idf/ desactualizado.
echo "Identidad de la imagen local:"
node ./scripts/image_tag.js "$image" --expect-arch "$SHOTSTOPPER_ARCH"

# El token viaja en un archivo de configuración de curl y no en la línea de
# comandos, donde cualquier `ps` lo dejaría a la vista.
curl_config="$(mktemp "${TMPDIR:-/tmp}/shotstopper-ota.XXXXXX")"
chmod 600 "$curl_config"
cleanup() { rm -f "$curl_config" "${body_file:-}"; }
trap cleanup EXIT
# Dentro de las comillas de un archivo de configuración de curl, \ y " son
# escapes. Una contraseña WPA2 puede contener ambos: sin escaparlos el token
# viaja truncado y el controlador responde OTA_TOKEN_INVALID sin más pistas.
ota_token="$(ss_get token)"
ota_token="${ota_token//\\/\\\\}"
ota_token="${ota_token//\"/\\\"}"
printf 'header = "X-OTA-Token: %s"\n' "$ota_token" > "$curl_config"
unset ota_token

body_file="$(mktemp "${TMPDIR:-/tmp}/shotstopper-ota-body.XXXXXX")"

# ota_request <método> <ruta> <archivo-de-cuerpo|""> <timeout>
# Deja el cuerpo de la respuesta en $body_file y el estado en $OTA_HTTP_STATUS.
ota_request() {
  local method="$1" path="$2" payload="$3" timeout="$4"
  local args=(--show-error --config "$curl_config"
              --max-time "$timeout" --output "$body_file"
              --write-out '%{http_code}' --request "$method")
  if [[ -n "$payload" ]]; then
    # La barra de progreso reemplaza a --silent: una imagen tarda minutos y sin
    # señal de avance parece un cuelgue.
    args+=(--progress-bar
           --header "Content-Type: application/octet-stream"
           --data-binary "@$payload")
  else
    args+=(--silent)
  fi
  OTA_HTTP_STATUS="$(curl "${args[@]}" "$base$path")" || return 1
  return 0
}

ota_field() {
  node -e '
const fs = require("fs");
let data = {};
try { data = JSON.parse(fs.readFileSync(process.argv[1], "utf8")); } catch (_) {}
const value = process.argv[2].split(".").reduce(
    (node, key) => (node == null ? undefined : node[key]), data);
process.stdout.write(value === undefined || value === null ? "" : String(value));
' "$body_file" "$1"
}

ota_fail() {
  local action="$1"
  local error message
  error="$(ota_field error)"
  message="$(ota_field message)"
  printf '%s falló (HTTP %s).\n' "$action" "${OTA_HTTP_STATUS:-sin respuesta}" >&2
  [[ -n "$error" ]] && printf 'Código: %s\n' "$error" >&2
  [[ -n "$message" ]] && printf '%s\n' "$message" >&2
  if [[ -z "$error" && -s "$body_file" ]]; then
    head -c 400 "$body_file" >&2
    printf '\n' >&2
  fi
  exit 1
}

echo
echo "Consultando $base ..."
ota_request GET /api/v1/ota "" 20 || {
  echo "No se pudo contactar al controlador en $base." >&2
  echo "Verifica la IP (Admin o Diagnostic del Web UI; en SoftAP es 192.168.4.1)." >&2
  exit 1
}
[[ "$OTA_HTTP_STATUS" == "200" ]] || ota_fail "La consulta de estado"

if [[ "$(ota_field available)" != "true" ]]; then
  echo "Este controlador no tiene una segunda partición de aplicación." >&2
  echo "Hay que actualizarlo por USB." >&2
  exit 1
fi
printf 'Controlador: %s · %s\n' "$(ota_field running.version)" "$(ota_field running.arch)"
if [[ "$(ota_field safe)" != "true" ]]; then
  printf 'La máquina está ocupada (%s). Espera a Ready.\n' "$(ota_field lockReason)" >&2
  exit 1
fi

size="$(wc -c < "$image" | tr -d ' ')"
printf 'Subiendo %s (%s KiB)...\n' "$image" "$((size / 1024))"
# Ventana amplia: la escritura en flash del ESP32 marca el ritmo, no la red.
ota_request POST /api/v1/ota "$image" 900 || {
  echo "Se cortó la subida. El firmware en ejecución no se tocó." >&2
  exit 1
}
[[ "$OTA_HTTP_STATUS" == "200" ]] || ota_fail "La verificación de la imagen"

staged_version="$(ota_field staged.version)"
staged_arch="$(ota_field staged.arch)"
if [[ -z "$staged_version" ]]; then
  echo "El controlador no reportó una imagen verificada." >&2
  exit 1
fi
printf '\nImagen verificada: %s · %s\n' "$staged_version" "$staged_arch"

if ss_can_prompt; then
  printf '¿Grabarla y reiniciar el controlador? [s/N]: ' > /dev/tty
  IFS= read -r answer < /dev/tty || answer=""
  case "$answer" in
    s|S|si|SI|Si|y|Y|yes|YES) ;;
    *)
      echo "Cancelado. Descartando la imagen del controlador."
      ota_request POST /api/v1/ota/abort "" 20 || true
      exit 1
      ;;
  esac
fi

echo "Grabando..."
ota_request POST /api/v1/ota/flash "" 30 || {
  echo "No se pudo confirmar el cambio de partición de arranque." >&2
  exit 1
}
[[ "$OTA_HTTP_STATUS" == "202" ]] || ota_fail "La grabación"

cat <<EOF

Listo. El controlador reinicia en cuanto la máquina esté libre.
La nueva versión se confirma sola al servir su Web UI; si no lo consigue, el
bootloader vuelve a la versión anterior.
EOF

ss_cli_save
