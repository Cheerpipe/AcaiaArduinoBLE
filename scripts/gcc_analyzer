#!/usr/bin/env bash
# Build the firmware with GCC's interprocedural static analyzer enabled.
set -uo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=scripts/shotstopper_board.sh
source "$SCRIPT_DIR/shotstopper_board.sh"
# shellcheck source=scripts/shotstopper_cli.sh
source "$SCRIPT_DIR/shotstopper_cli.sh"

readonly ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
readonly OUTPUT_DIR="reports/gcc-analyzer"

usage() {
  cat <<EOF
Uso: ./scripts/gcc_analyzer [flags]

Compila Shot Stopper con GCC -fanalyzer y guarda el resultado filtrado en
reports/gcc-analyzer/gcc-analyzer.txt. Reemplaza el reporte anterior.
El registro completo de compilación queda en gcc-analyzer-raw.txt; el reporte
principal conserva únicamente diagnósticos cuya ubicación inicial es código
versionado en este repositorio.

Parámetros que necesita: --arch. --flags es opcional y se añade al análisis.

$(ss_flag_help)

$(shotstopper_arch_help)

Ejemplos:
  ./scripts/gcc_analyzer --arch n16r8
  ./scripts/gcc_analyzer -a n8r4 -f "-DSHOT_STOPPER_ENABLE_BUZZER=1"
EOF
}

ss_cli_parse "$@" || exit $?
if [[ "$SS_CLI_HELP_REQUESTED" == "1" ]]; then
  usage
  exit 0
fi

ss_cli_resolve "arch" "flags" || exit $?
if ! shotstopper_resolve_board "$(ss_get arch)"; then
  exit 2
fi

cd "$ROOT"
output_path="$ROOT/$OUTPUT_DIR"
rm -rf "$output_path"
mkdir -p "$output_path"

echo "Ejecutando GCC -fanalyzer para $SHOTSTOPPER_ARCH..."
# -fanalyzer is a tool flag, not a user preference: passing it through
# ./scripts/build would persist it into .shotstopper and every later compile.
user_flags="$(ss_get flags)"
analyzer_flags="$user_flags -fanalyzer"

raw_report="$output_path/gcc-analyzer-raw.txt"
report="$output_path/gcc-analyzer.txt"

SHOTSTOPPER_NONINTERACTIVE=1 ./scripts/build --arch "$SHOTSTOPPER_ARCH" \
  --flags "$analyzer_flags" >"$raw_report" 2>&1
build_status=$?

ss_put flags "$user_flags" cli
ss_cli_save

if [[ $build_status -ne 0 ]]; then
  cat "$raw_report" >&2
  printf 'Architecture: %s\nGCC analyzer exit status: %d\n' \
    "$SHOTSTOPPER_ARCH" "$build_status" > "$output_path/README.txt"
  echo "La compilación falló; registro guardado en $OUTPUT_DIR/gcc-analyzer-raw.txt" >&2
  exit "$build_status"
fi

# GCC analiza también las librerías instaladas transitivamente. Conservamos el
# bloque de cada advertencia solo cuando su ubicación principal pertenece al
# repositorio; las trazas asociadas se mantienen para que el diagnóstico sirva.
awk -v root="$ROOT/" '
  /^[^:]+:[0-9]+:[0-9]+: (warning|error):/ {
    if ($0 ~ /\[-Wanalyzer-/) {
      keep = index($0, root) == 1
      if (keep) print
      next
    }
    keep = 0
  }
  keep { print }
' "$raw_report" > "$report"

analyzer_status=0

if grep -q '\[-Wanalyzer-' "$report"; then
  analyzer_status=1
fi

printf 'Architecture: %s\nGCC analyzer exit status: %d\n' \
  "$SHOTSTOPPER_ARCH" "$analyzer_status" > "$output_path/README.txt"

echo "Reporte guardado en $OUTPUT_DIR/"
exit "$analyzer_status"
