#!/usr/bin/env bash
# Build the firmware with GCC's interprocedural static analyzer enabled.
set -uo pipefail

readonly DEFAULT_PORT="/dev/cu.usbserial-0001"
readonly DEFAULT_ARCH="esp32"
readonly DEFAULT_FLAGS=(
  -Werror=deprecated-copy
  -DSHOT_STOPPER_ENABLE_REMOTE_CN9=1
  -DSHOT_STOPPER_ENABLE_BUZZER=2
)
readonly ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
readonly OUTPUT_DIR="reports/gcc-analyzer"

usage() {
  cat <<'EOF'
Uso: ./scripts/gcc_analyzer [ruta_serial arquitectura [flags_de_compilacion...]]

Compila Shot Stopper con GCC -fanalyzer y guarda el resultado filtrado en
reports/gcc-analyzer/gcc-analyzer.txt. Reemplaza el reporte anterior.
El registro completo de compilación queda en gcc-analyzer-raw.txt; el reporte
principal conserva únicamente diagnósticos cuya ubicación inicial es código
versionado en este repositorio.

Sin argumentos usa la configuración de desarrollo de build. Si se indica una
ruta serial, la arquitectura también es obligatoria. Los flags adicionales se
añaden a los flags de desarrollo y al análisis.

Arquitecturas admitidas: esp32, esp32s3.

Ejemplos:
  ./scripts/gcc_analyzer
  ./scripts/gcc_analyzer /dev/cu.usbserial-0001 esp32
  ./scripts/gcc_analyzer /dev/cu.usbmodem01 esp32s3 -DSHOT_STOPPER_ENABLE_ALED=1
EOF
}

if [[ "${1:-}" == "help" || "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  if [[ $# -ne 1 ]]; then
    usage >&2
    exit 2
  fi
  usage
  exit 0
fi

if [[ $# -eq 0 ]]; then
  port="$DEFAULT_PORT"
  arch="$DEFAULT_ARCH"
  extra_flags=()
elif [[ $# -eq 1 ]]; then
  echo "Falta la arquitectura después de la ruta serial." >&2
  usage >&2
  exit 2
else
  port="$1"
  arch="$2"
  extra_flags=("${@:3}")
fi

case "$arch" in
  esp32|esp32s3) ;;
  *)
    echo "Arquitectura no admitida: $arch (usa esp32 o esp32s3)." >&2
    exit 2
    ;;
esac

cd "$ROOT"
output_path="$ROOT/$OUTPUT_DIR"
rm -rf "$output_path"
mkdir -p "$output_path"

echo "Ejecutando GCC -fanalyzer para $arch..."
build_args=("$port" "$arch" "${DEFAULT_FLAGS[@]}")
if [[ ${#extra_flags[@]} -gt 0 ]]; then
  build_args+=("${extra_flags[@]}")
fi
build_args+=(-fanalyzer)

raw_report="$output_path/gcc-analyzer-raw.txt"
report="$output_path/gcc-analyzer.txt"

./scripts/build "${build_args[@]}" >"$raw_report" 2>&1
build_status=$?

if [[ $build_status -ne 0 ]]; then
  cat "$raw_report" >&2
  printf 'Architecture: %s\nGCC analyzer exit status: %d\n' \
    "$arch" "$build_status" > "$output_path/README.txt"
  echo "La compilación falló; registro guardado en $OUTPUT_DIR/gcc-analyzer-raw.txt" >&2
  exit "$build_status"
fi

# GCC analiza también las librerías instaladas transitivamente. Conservamos el
# bloque de cada advertencia solo cuando su ubicación principal pertenece al
# repositorio; las trazas asociadas se mantienen para que el diagnóstico sirva.
awk -v root="$ROOT/" '
  /^[^:]+:[0-9]+:[0-9]+: (warning|error):/ {
    if ($0 ~ /\[-Wanalyzer-/) {
      keep = index($0, root) == 1
      if (keep) print
      next
    }
    keep = 0
  }
  keep { print }
' "$raw_report" > "$report"

analyzer_status=0

if rg -q '\[-Wanalyzer-' "$report"; then
  analyzer_status=1
fi

printf 'Architecture: %s\nGCC analyzer exit status: %d\n' \
  "$arch" "$analyzer_status" > "$output_path/README.txt"

echo "Reporte guardado en $OUTPUT_DIR/"
exit "$analyzer_status"
