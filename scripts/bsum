#!/usr/bin/env bash
# Build, static-report, upload, and monitor Shot Stopper in one command.
set -euo pipefail

usage() {
  cat <<'EOF'
Uso: ./scripts/bsum [ruta_serial arquitectura velocidad [flags_de_compilacion...]]

Ejecuta, en orden: build, static_report, upload y monitor.

Sin argumentos invoca cada script sin parámetros, por lo que conserva sus
valores por defecto.

Si se indica ruta_serial, arquitectura y velocidad son obligatorias. Los flags
restantes se envían únicamente a build.

Arquitecturas admitidas: n8r4, n16r8 (alias: esp32s3 → n16r8).

Sin argumentos, cada script usa n16r8 y el primer /dev/cu.usbmodem<número>.

Ejemplos:
  ./scripts/bsum
  ./scripts/bsum /dev/cu.usbmodem2101 n16r8 115200
  ./scripts/bsum /dev/cu.usbmodem2101 n8r4 115200 -DSHOT_STOPPER_ENABLE_ALED=1
EOF
}

if [[ "${1:-}" == "help" || "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  if [[ $# -ne 1 ]]; then
    usage >&2
    exit 2
  fi
  usage
  exit 0
fi

if [[ $# -eq 0 ]]; then
  args=()
elif [[ $# -lt 3 ]]; then
  echo "Ruta serial, arquitectura y velocidad son obligatorias cuando se pasan argumentos." >&2
  usage >&2
  exit 2
else
  args=("$@")
fi

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=scripts/shotstopper_board.sh
source "$SCRIPT_DIR/shotstopper_board.sh"

root="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
cd "$root"

if [[ ${#args[@]} -eq 0 ]]; then
  ./scripts/build
  ./scripts/static_report
  ./scripts/upload
  exec ./scripts/monitor
fi

shotstopper_resolve_board "${args[1]}"

if [[ ${#args[@]} -eq 3 ]]; then
  ./scripts/build "${args[0]}" "${args[1]}"
else
  ./scripts/build "${args[0]}" "${args[1]}" "${args[@]:3}"
fi
./scripts/static_report "$SHOTSTOPPER_BUILD_DIR"
./scripts/upload "${args[0]}" "${args[1]}"
exec ./scripts/monitor "${args[0]}" "${args[2]}"
