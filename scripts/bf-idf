#!/usr/bin/env bash
# Build and flash Shot Stopper (ESP-IDF) in one command.
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# shellcheck source=scripts/shotstopper_board.sh
source "$SCRIPT_DIR/shotstopper_board.sh"
# shellcheck source=scripts/shotstopper_cli.sh
source "$SCRIPT_DIR/shotstopper_cli.sh"

usage() {
  cat <<EOF
Usage: ./scripts/bf-idf [flags]

Runs, in order: build-idf and flash-idf.

Required parameters: --port and --arch. --flags is optional.

$(ss_flag_help)

Examples:
  ./scripts/bf-idf --port /dev/cu.usbmodem2101 --arch n16r8
  ./scripts/bf-idf -p /dev/cu.usbmodem2101 -a n8r4 -f "-DSHOT_STOPPER_ENABLE_BUZZER=1"
EOF
}

ss_cli_parse "$@" || exit $?
if [[ "$SS_CLI_HELP_REQUESTED" == "1" ]]; then
  usage
  exit 0
fi

# Resolve everything once here so the child scripts never prompt again.
ss_cli_resolve "port arch" "flags" || exit $?

root="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
cd "$root"

ss_cli_flags_for arch flags
./scripts/build-idf ${SS_CLI_FORWARD[@]+"${SS_CLI_FORWARD[@]}"}

ss_cli_flags_for port arch
exec ./scripts/flash-idf ${SS_CLI_FORWARD[@]+"${SS_CLI_FORWARD[@]}"}
